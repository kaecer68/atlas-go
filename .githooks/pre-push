#!/usr/bin/env bash
# .githooks/pre-push — Block pushes before they reach the remote
#
# Gates:
#   1.  `make ci-gate`  (~30s) — fast gate, always runs (gofmt/build/vet/gen-drift/ci-quick)
#   1b. `make ci-full`  (~5-8 min) — full local suite (lint/staticcheck/test/race/coverage);
#       runs when the diff contains code (non-docs). Avoids push→CI-fail round trips.
#       Overrides: PRE_PUSH_FULL=always 強制全量 / never 跳過 / auto 依 diff 判定(預設)
#   2.  Local branch HEAD == origin/main → nothing meaningful to push
#   3.  Zero file diff vs origin/main      → PR will be closed as redundant
#       (this is the exact failure mode that produced PR #799)
#
# Install: bash scripts/install-hooks.sh
# Skip with: git push --no-verify (use only if you know what you're doing)

set -euo pipefail

remote="$1"
url="$2"

# Only check the primary remote. Forks / mirrors can be intentional.
if [ "$remote" != "origin" ]; then
  exit 0
fi

# ── Gate 1: CI preflight ──────────────────────────────────────────
# make ci-gate covers: gofmt, go build, go vet, go generate drift,
# and fast CI scripts. ~30s, catches 90% of CI failures.
if ! make ci-gate 2>&1; then
  echo ""
  echo "❌ pre-push: make ci-gate FAILED."
  echo "   Fix the issues above before pushing."
  echo "   Bypass with: git push --no-verify"
  echo ""
  exit 1
fi

# ── Gate 1b: full CI preflight for code changes ──────────────────
# Fast-fetch origin/main so diffs are accurate.
if ! git fetch origin main --quiet 2>/dev/null; then
  echo "⚠️  pre-push: cannot fetch origin/main — skipping ci-full/redundancy checks"
  exit 0
fi

# ── Gate 1c: frontend dist freshness (frontend changes only) ─────
# The backend embeds admin_web/dist + client_web/dist via go:embed; a stale
# dist silently ships the old UI into the binary. Only admin_web/client_web/
# shared_web changes can invalidate dist, so pure Go/docs pushes skip this
# entirely (see scripts/ci/check_frontend_dist.sh).
if ! bash scripts/ci/check_frontend_dist.sh --diff origin/main...HEAD 2>&1; then
  echo ""
  echo "❌ pre-push: frontend dist 過期/缺失 (見上方輸出)."
  echo "   修復: 在對應前端目錄跑 npm ci && npm run build, 再重新 push."
  echo "   Bypass with: git push --no-verify"
  echo ""
  exit 1
fi

# Code change? (docs-only diffs skip ci-full — ci-gate suffices)
code_changed=0
if git diff --name-only origin/main...HEAD 2>/dev/null | grep -qE '\.(go|ts|tsx|js|jsx|vue|py|sh|c|cpp|h)$|(^|/)Makefile$|Dockerfile|docker-compose|\.github/|\.githooks/'; then
  code_changed=1
fi

mode="${PRE_PUSH_FULL:-auto}"
if [ "$mode" = "always" ] || { [ "$mode" = "auto" ] && [ "$code_changed" -eq 1 ]; }; then
  echo ""
  echo "🧪 pre-push: diff 含程式碼變更 → 跑 make ci-full (~5-8 min)..."
  echo "   （PRE_PUSH_FULL=always/never 可覆寫; docs-only diff 自動只跑 ci-gate）"
  if ! make ci-full 2>&1; then
    echo ""
    echo "❌ pre-push: make ci-full FAILED."
    echo "   已在本地抓到問題，修好再 push（避免 push→CI-fail 往返）。"
    echo "   Bypass with: git push --no-verify"
    echo ""
    exit 1
  fi
elif [ "$mode" != "never" ]; then
  echo "ℹ️  pre-push: docs-only diff — ci-gate 已足夠（ci-full 跳過）"
fi

# ── Gate 2: HEAD already on main ──────────────────────────────────
local_sha=$(git rev-parse HEAD)

main_sha=$(git rev-parse origin/main)

if [ "$local_sha" = "$main_sha" ]; then
  echo ""
  echo "❌ pre-push: HEAD is already on origin/main."
  echo "   Nothing to push. Did you mean to merge first?"
  echo "   If pushing main itself: git push --no-verify"
  echo ""
  exit 1
fi

# ── Gate 3: zero diff vs origin/main ──────────────────────────────
diff_count=$(git diff --name-only origin/main...HEAD 2>/dev/null | wc -l | tr -d ' ')
if [ "$diff_count" -eq 0 ]; then
  echo ""
  echo "❌ pre-push: branch has zero file diff vs origin/main."
  echo "   PR will be empty / closed as redundant (see PR #799 lesson)."
  echo "   Verify with: git diff --stat origin/main...HEAD"
  echo "   Bypass with: git push --no-verify"
  echo ""
  exit 1
fi

echo "✅ pre-push: ci-gate passed, $diff_count file(s) differ from origin/main — push allowed"
exit 0
