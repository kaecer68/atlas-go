#!/usr/bin/env bash
# .githooks/pre-push — Block pushes before they reach the remote
#
# Gates:
#   0.  Refresh origin/main — **fail-closed**. Every gate below is diff-based
#       against origin/main; running them against a missing/stale ref produced a
#       green signal that meant nothing (a look-green, checked-nothing push).
#   0b. Host binary freshness (`bin/atlas`, `bin/atlas-mcp`) — only when this
#       push moves a build input. Rule + paths + fix hints come from
#       `scripts/check-binary-freshness.sh --host-only` (one freshness rule in
#       this repo, not two; and it never invokes docker, a push must not need a
#       daemon). Clones without bin/ (fresh/linked worktrees) are not judged.
#   1.  `make ci-gate`  (~30s) — fast gate, always runs (gofmt/build/vet/gen-drift/ci-quick)
#   1b. `make ci-full`  (~5-8 min) — full local suite (lint/staticcheck/test/race/coverage);
#       runs when the diff contains code (non-docs). Avoids push→CI-fail round trips.
#       Overrides: PRE_PUSH_FULL=always 強制全量 / never 跳過 / auto 依 diff 判定(預設)
#   1c. frontend dist freshness (frontend changes only)
#   2.  Local branch HEAD == origin/main → nothing meaningful to push
#   3.  Zero file diff vs origin/main      → PR will be closed as redundant
#       (this is the exact failure mode that produced PR #799)
#
#   A DELETE-ONLY push (every refspec git hands us on stdin is a deletion) exits
#   early, naming the gates it skipped and why — see "Push classification" below.
#   Nothing here judges a deletion's content, and post-merge branch cleanup is
#   exactly the case that used to force `--no-verify` (E30, 2026-09-27).
#
# Install: bash scripts/install-hooks.sh
# Skip with: git push --no-verify (use only if you know what you're doing)

set -euo pipefail

remote="$1"
url="$2"

# Only check the primary remote. Forks / mirrors can be intentional.
if [ "$remote" != "origin" ]; then
  exit 0
fi

# Resolve the repo from the hook's own location, not from cwd: the gates below
# call repo-relative scripts, and `make check-binaries` resolves bin/ from the
# script's own directory.
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

# ── Push classification: read this push's refspecs from STDIN ─────
# 2026-09-27 (E30): the refs being pushed are NOT in argv — git writes them to
# the hook's stdin, one per line:
#     <local ref> <local sha> <remote ref> <remote sha>
# A deletion is announced as `(delete) 0000…0 <remote ref> <old sha>`. Measured
# directly (git 2.52.0, this host, 2026-09-27), this one shape covers
# `git push --delete origin X`, `git push origin :X` and tag deletions.
# NOT covered, and deliberately so: `git push --mirror` was measured (twice) as
# NOT reporting its deletions on stdin — once handing the hook an empty list,
# once a list holding only a create line — while still deleting a remote-only
# branch. A mirror push is therefore classified as a content push and stays
# subject to every gate (fail-closed; it never silently gets the delete-only
# pass).
#
# Why this matters: every gate below judges *content* (0b binary freshness, 1
# ci-gate, 1b ci-full, 1c frontend dist, 2 HEAD==origin/main, 3 zero-diff). A
# delete carries no content, and in the routine post-merge cleanup case the
# branch is already merged, so `git diff origin/main...HEAD` is empty and Gate 3
# fired: the delete was refused and the only way through was
# `git push --no-verify` — i.e. routine cleanup forced the operator to switch the
# whole gate set off. Now delete-only pushes skip explicitly and loudly.
#
# Read stdin exactly once (git writes it once, then closes the pipe) and classify:
#   delete_only=1  ⇔  at least one refspec line AND every line is a deletion.
# Fail-closed on the unknown: no refspec information (empty stdin, or a TTY when
# the hook is run by hand) ⇒ delete_only=0, i.e. treat it as a content push and
# keep every gate. A mixed push (one deletion + one content line) ⇒
# delete_only=0, so a deletion can never whitewash the content pushed beside it.
# The read is bounded (-t 1) so a caller that hands us an open-but-silent pipe
# cannot hang the push; a timeout can only lose lines, which fails closed.
delete_only=0
refspec_total=0
refspec_deletes=0
if [ ! -t 0 ]; then
  while IFS= read -r -t 1 refspec_line || [ -n "$refspec_line" ]; do
    refspec_total=$((refspec_total + 1))
    case "$refspec_line" in
      '(delete) '*) refspec_deletes=$((refspec_deletes + 1)) ;;
    esac
  done
fi
if [ "$refspec_total" -gt 0 ] && [ "$refspec_deletes" -eq "$refspec_total" ]; then
  delete_only=1
fi

if [ "$delete_only" -eq 1 ]; then
  echo ""
  echo "✅ pre-push: delete-only push（$refspec_deletes 個 ref 全是刪除，沒有內容）— 放行。"
  echo "   理由：delete-only push：沒有內容可守。以下是本次明示跳過的閘門："
  echo "     Gate 0b  host binary freshness（bin/atlas* 落後原始碼）"
  echo "     Gate 1   make ci-gate"
  echo "     Gate 1b  make ci-full"
  echo "     Gate 1c  frontend dist freshness"
  echo "     Gate 2   HEAD == origin/main（空內容推送才有意義）"
  echo "     Gate 3   zero file diff vs origin/main（同上）"
  echo "   這些閘門全都在判斷『內容』；刪除遠端分支/標籤不帶任何內容。"
  echo "   若這其實是內容 push，git 會在 stdin 給出非 delete 的 refspec 行。"
  echo ""
  exit 0
fi

# ── Gate 0: refresh origin/main (fail-closed) ─────────────────────
# 2026-09-26 (E4): this used to `exit 0` when the fetch failed, i.e. it silently
# allowed the push while skipping ci-full AND every diff-based gate (frontend
# dist, HEAD==origin/main, zero-diff). A gate that turns green because it could
# not run is worse than no gate. Now: refuse and say how to bypass explicitly.
if ! fetch_out=$(git fetch origin main 2>&1); then
  echo ""
  echo "❌ pre-push: cannot fetch origin/main — push refused (fail-closed)."
  echo "   原因：本 hook 的每一個 diff 閘門（frontend dist、ci-full 範圍、"
  echo "   HEAD==origin/main、zero-diff）都以 origin/main 為基準。取不到它，"
  echo "   這些檢查只能對著過期的 ref 跑，結果一定是『看起來綠、實際沒檢查』。"
  if [ -n "$fetch_out" ]; then
    echo "   git fetch 說："
    printf '%s\n' "$fetch_out" | sed 's/^/     /'
  fi
  echo "   修復：恢復對 origin 的讀取權（先試 git ls-remote origin main）"
  echo "         或明示繞過：git push --no-verify"
  echo ""
  exit 1
fi

# ── Gate 0b: host binary freshness (build inputs only, no docker) ──
# 2026-09-26 (FU-20260926-15): source had moved ahead of bin/atlas-mcp and the
# push still went through. Only the host-side build outputs are judged, and only
# when this push carries a build-input change (`--diff-base origin/main`).
host_out=""
if ! host_out=$(bash scripts/check-binary-freshness.sh --host-only --diff-base origin/main 2>&1); then
  echo ""
  echo "❌ pre-push: host binary freshness gate FAILED（宿主端 bin/atlas* 落後原始碼）."
  echo ""
  printf '%s\n' "$host_out"
  echo ""
  echo "   修復（純 go build，不含 docker）:"
  echo "     make rebuild-host-bin   # bin/atlas-mcp"
  echo "     make build-backend      # bin/atlas"
  echo "   或明示繞過：git push --no-verify"
  echo ""
  exit 1
fi

# ── Gate 1: CI preflight ──────────────────────────────────────────
# make ci-gate covers: gofmt, go build, go vet, go generate drift,
# and fast CI scripts. ~30s, catches 90% of CI failures.
if ! make ci-gate 2>&1; then
  echo ""
  echo "❌ pre-push: make ci-gate FAILED."
  echo "   Fix the issues above before pushing."
  echo "   Bypass with: git push --no-verify"
  echo ""
  exit 1
fi

# ── Gate 1c: frontend dist freshness (frontend changes only) ─────
# The backend embeds admin_web/dist + client_web/dist via go:embed; a stale
# dist silently ships the old UI into the binary. Only admin_web/client_web/
# shared_web changes can invalidate dist, so pure Go/docs pushes skip this
# entirely (see scripts/ci/check_frontend_dist.sh).
if ! bash scripts/ci/check_frontend_dist.sh --diff origin/main...HEAD 2>&1; then
  echo ""
  echo "❌ pre-push: frontend dist 過期/缺失 (見上方輸出)."
  echo "   修復: 在對應前端目錄跑 npm ci && npm run build, 再重新 push."
  echo "   Bypass with: git push --no-verify"
  echo ""
  exit 1
fi

# Code change? (docs-only diffs skip ci-full — ci-gate suffices)
code_changed=0
if git diff --name-only origin/main...HEAD 2>/dev/null | grep -qE '\.(go|ts|tsx|js|jsx|vue|py|sh|c|cpp|h)$|(^|/)Makefile$|Dockerfile|docker-compose|\.github/|\.githooks/'; then
  code_changed=1
fi

mode="${PRE_PUSH_FULL:-auto}"
if [ "$mode" = "never" ]; then
  # An override that skips a required gate must SAY SO. Before 2026-09-26 this
  # branch printed nothing: the push went out with no trace that ci-full never
  # ran — the same silent-skip shape as the E4 fetch fail-open.
  echo "ℹ️  pre-push: PRE_PUSH_FULL=never — ci-full 明示跳過（ci-gate 已通過；這是使用者覆寫）"
elif [ "$mode" = "always" ] || { [ "$mode" = "auto" ] && [ "$code_changed" -eq 1 ]; }; then
  echo ""
  echo "🧪 pre-push: diff 含程式碼變更 → 跑 make ci-full (~5-8 min)..."
  echo "   （PRE_PUSH_FULL=always/never 可覆寫; docs-only diff 自動只跑 ci-gate）"
  if ! make ci-full 2>&1; then
    echo ""
    echo "❌ pre-push: make ci-full FAILED."
    echo "   已在本地抓到問題，修好再 push（避免 push→CI-fail 往返）。"
    echo "   Bypass with: git push --no-verify"
    echo ""
    exit 1
  fi
else
  echo "ℹ️  pre-push: docs-only diff — ci-gate 已足夠（ci-full 跳過）"
fi

# ── Gate 2: HEAD already on main ──────────────────────────────────
local_sha=$(git rev-parse HEAD)

main_sha=$(git rev-parse origin/main)

if [ "$local_sha" = "$main_sha" ]; then
  echo ""
  echo "❌ pre-push: HEAD is already on origin/main."
  echo "   Nothing to push. Did you mean to merge first?"
  echo "   If pushing main itself: git push --no-verify"
  echo ""
  exit 1
fi

# ── Gate 3: zero diff vs origin/main ──────────────────────────────
diff_count=$(git diff --name-only origin/main...HEAD 2>/dev/null | wc -l | tr -d ' ')
if [ "$diff_count" -eq 0 ]; then
  echo ""
  echo "❌ pre-push: branch has zero file diff vs origin/main."
  echo "   PR will be empty / closed as redundant (see PR #799 lesson)."
  echo "   Verify with: git diff --stat origin/main...HEAD"
  echo "   Bypass with: git push --no-verify"
  echo ""
  exit 1
fi

echo "✅ pre-push: origin/main refreshed, host binaries fresh (or N/A), ci-gate passed, $diff_count file(s) differ from origin/main — push allowed"
exit 0
