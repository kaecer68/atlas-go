#!/bin/sh
# atlas-go pre-commit hook
# Blocks Mach-O/ELF compiled binaries and orphan artifacts from entering git index.

set -e

echo "🔍 pre-commit: checking for orphan/build artifacts..."

had_errors=0

# ─── Check 1: Mach-O / ELF compiled binaries ─────────────────────────────
staged_files=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)

# On macOS, `file` detects Mach-O. On Linux, ELF.
for f in $staged_files; do
  if [ -f "$f" ]; then
    ft=$(file "$f" 2>/dev/null)
    case "$ft" in
      *"Mach-O"*|*"ELF"*)
        echo "ERROR: Compiled binary should not be committed: $f"
        echo "  → Add to .gitignore and run: git rm --cached $f"
        had_errors=1
        ;;
    esac
  fi
done

# ─── Check 2: PID files ──────────────────────────────────────────────────
for f in $staged_files; do
  case "$f" in
    *.pid)
      echo "ERROR: PID file should not be committed: $f"
      echo "  → Add /.gitignore entry and run: git rm --cached $f"
      had_errors=1
      ;;
  esac
done

# ─── Check 3: Coverage output files ──────────────────────────────────────
for f in $staged_files; do
  case "$f" in
    *.out|cov_*|coverage.out)
      echo "ERROR: Coverage report should not be committed: $f"
      echo "  → /.gitignore already covers '*.out'. Run: git rm --cached $f"
      had_errors=1
      ;;
  esac
done

if [ "$had_errors" -ne 0 ]; then
  echo ""
  echo "❌ Commit blocked. Remove the offending files from the index and try again."
  echo "   Tip: git rm --cached <file>  (keeps file on disk)"
  exit 1
fi

# ─── Check 4: Frontend dynamic imports ──────────────────────────────────
# When admin_web/client_web main.js or shared_web/pages/*.js are staged,
# verify every dynamic import resolves to an existing shared_web page.
# Catches the silent esbuild fallback failure mode (PR #785).
frontend_changed=$(echo "$staged_files" | grep -E '^(admin_web|client_web)/static/js/main\.js$|^(shared_web)/static/js/pages/[a-z_-]+\.js$' || true)
if [ -n "$frontend_changed" ]; then
  echo ""
  echo "🔍 pre-commit: frontend dynamic import check (PR #785 / script from PR #789)"
  if [ -x "scripts/ci/check_frontend_imports.sh" ]; then
    if ! bash scripts/ci/check_frontend_imports.sh; then
      echo ""
      echo "❌ Commit blocked. admin_web / client_web / shared_web dynamic imports are inconsistent."
      echo "   See scripts/ci/check_frontend_imports.sh output above."
      echo "   Common cause: deleted or renamed a shared_web/static/js/pages/*.js file"
      echo "   without updating the matching import in admin_web/static/js/main.js or client_web/static/js/main.js."
      exit 1
    fi
    echo "  ✅ frontend imports consistent"
  else
    echo "  ⚠️  scripts/ci/check_frontend_imports.sh not found or not executable — skipping"
  fi
fi

# ─── Check 5: Go-generated files drift ────────────────────────────────
# When any Go file in internal/ is staged, run `go generate ./...` and verify
# the auto-generated frontend files (field_types.ts, valid_fields.json) in ALL
# 3 active web directories don't drift. These files MUST only be modified by
# `go generate`; manual edits get overwritten and break CI.
# See shared_web/AGENTS.md "Generated Files" section and docs/TRAPS.md "Build Pipeline".
go_staged=$(echo "$staged_files" | grep -E '^internal/.*\.go$' || true)
if [ -n "$go_staged" ]; then
  echo ""
  echo "🔍 pre-commit: go generate drift check (PR #795)..."
  if ! command -v go >/dev/null 2>&1; then
    echo "  ⚠️  go not found in PATH — skipping"
  else
    # All 3 active web directories must have identical copies generated by cmd/gentags.
    # The copies exist because each admin_web/client_web/shared_web
    # has its own esbuild pipeline — they don't share a single dist.
    # web/ is deprecated and no longer regenerated.
    gen_dirs="admin_web client_web shared_web"

    # Snapshot all generated files before running go generate
    snapshot_dir=$(mktemp -d)
    for d in $gen_dirs; do
      mkdir -p "$snapshot_dir/$d"
      for f in field_types.ts valid_fields.json; do
        src="$d/static/js/shared/$f"
        if [ -f "$src" ]; then
          cp "$src" "$snapshot_dir/$d/$f"
        fi
      done
    done

    # Run go generate, suppress stdout to keep pre-commit output clean
    gen_output=$(go generate ./... 2>&1) || {
      echo "  ❌ go generate ./... failed:"
      echo "$gen_output" | sed 's/^/    /'
      echo "  Fix the failing generator before committing."
      had_errors=1
    }

    # Only check drift if generate didn't fail
    if [ "$had_errors" -eq 0 ]; then
      had_drift=0
      for d in $gen_dirs; do
        for f in field_types.ts valid_fields.json; do
          gen_file="$d/static/js/shared/$f"
          snap_file="$snapshot_dir/$d/$f"
          if [ -f "$snap_file" ]; then
            before=$(cat "$snap_file")
            after=$(cat "$gen_file" 2>/dev/null || echo "")
            if [ "$before" != "$after" ]; then
              echo ""
              echo "  ❌ $gen_file drift detected"
              echo "     This file is auto-generated by cmd/gentags. Manual edits will be"
              echo "     overwritten on next 'go generate ./...' and break CI."
              echo "     → To add/change/remove a frontend field, edit the corresponding Go"
              echo "       struct's json:\"...\" tag in internal/<pkg>/, then re-run 'go generate .'"
              echo "       and stage the regenerated file."
              echo "     → See shared_web/AGENTS.md 'Generated Files' section and docs/TRAPS.md 'Build Pipeline'."
              # Restore original (working tree, not index) so commit doesn't include stale content
              cp "$snap_file" "$gen_file"
              had_drift=1
            fi
          fi
        done
      done
      if [ "$had_drift" -eq 0 ]; then
        echo "  ✅ generated files consistent (all 3 copies)"
      fi
      had_errors=$had_drift
    fi

    # Clean up snapshot
    rm -rf "$snapshot_dir"
  fi
fi

if [ "$had_errors" -ne 0 ]; then
  echo ""
  echo "❌ Commit blocked. Fix the issues above and try again."
  exit 1
fi

echo "✅ pre-commit: all checks passed"
