# =============================================================================
# Atlas Configuration Template
# Copy to .env and fill in your values. NEVER commit .env to version control.
#
# ⚠️ THIS FILE IS A TEMPLATE. Real runtime values for this dev environment live
#    at ~/.config/atlas-go/.env (per docs/environment.md). Do not confuse the
#    template with the active configuration file.
#
# Placement: Put this file at ONE of these locations:
#   - ./.env (repo root, gitignored)
#   - ~/.config/atlas-go/.env (recommended for public repos)
#   - Or set ATLAS_ENV_FILE=/path/to/.env to use a custom location
#
# SECRETS: On macOS, API keys and passwords are stored in Keychain.
# To set up:  security add-generic-password -a "KEY_NAME" -s com.kaecer68.atlas-go -w "value"
# To read:    security find-generic-password -a "KEY_NAME" -s com.kaecer68.atlas-go -w
#
# On Linux/CI, set the env vars directly instead.
# =============================================================================

# --- Security ---
# ATLAS_ENV=development          # Set to 'production' to enforce API key auth.
#                                #   Default is 'development' so /health returns 200.
# ⚠️  ATLAS_ENV=production MUST ONLY be enabled in a dedicated, isolated worktree
#     or deployment environment. NEVER set production in the same worktree used
#     for development, experiments, backtests, or `go run` debugging. When
#     ATLAS_ENV=production, dev/experiment commands are blocked by the agent
#     guard hooks (see .agent-hooks/deny-dangerous.sh and docs/environment.md).
ATLAS_ENV=development
# ATLAS_API_KEY is required when ATLAS_ENV=production (see
# internal/monitoring/api/shared/handler.go AuthMiddleware). The
# development placeholder below matches install guide §3; replace
# with `openssl rand -hex 32` for production deployments.
ATLAS_API_KEY=e2e-test-key-not-for-prod

# --- Database ---
# DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas?sslmode=disable
# ATLAS_MIGRATIONS_PATH=sql/migrations

# --- Market Data ---
# Provider: twse | fugle | hybrid
ATLAS_MARKET_DATA_PROVIDER=twse
ATLAS_PRIMARY_MARKET=TW
ATLAS_REPLAY_MODE=daily
ATLAS_REPLAY_DATA_PATH=samples/replay/twse_stock_day_all_sample.csv
ATLAS_REPLAY_SESSION_DATE=2026-03-26
ATLAS_YAHOO_ENABLED=false

# --- API Keys (stored in Keychain on macOS) ---
# Keychain account names: FINMIND_API_KEY, FUGLE_API_KEY, TEJ_API_KEY
# On non-macOS, set as env vars directly.
# FinMind: https://api.finmindtrade.com/ (free tier: 600 req/hr)
# FINMIND_API_KEY=
# Fugle: real-time market data
# FUGLE_API_KEY=
# TEJ: premium financial data
# TEJ_API_KEY=

# --- Fubon Broker Integration ---
# FUBON_API_KEY and FUBON_PERSONAL_ID are needed by services/fubon-proxy/main.py.
# FUBON_PASSWORD is stored in Keychain (account: FUBON_PASSWORD).
FUBON_API_KEY=
FUBON_PERSONAL_ID=
# FUBON_PASSWORD=
FUBON_CERT_PATH=
# FUBON_CERT_PASSWORD=

# --- Paths ---
ATLAS_AGENT_REGISTRY_PATH=configs/agents.json
ATLAS_BASELINE_POLICY_PATH=data/state/baseline_policy.json
ATLAS_LEDGER_DIR=data/state
