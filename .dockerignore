# Git
.git
.gitignore
.gitattributes

# Go
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
vendor/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
# Top-level dist/ (catches shared_web/dist if present)
dist/
build/
bin/
atlas-go
# Sub-app build outputs — MUST be excluded so Docker nodebuilder stage is the
# sole source of truth for the embedded dist. Stale local builds otherwise
# mask newer source when COPY runs (see PR #976 follow-up).
client_web/dist/
admin_web/dist/
shared_web/dist/

# Data and logs (mount as volumes)
data/*
!data/.gitkeep
logs/*
!logs/.gitkeep
reports/*
!reports/.gitkeep

# Environment files
.env
.env.local
.env.*.local

# Documentation (keep in repo, not needed in image)
docs/*.md
!docs/*.json

# Tests
*_test.go
test/
tests/

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# Docker
Dockerfile*
docker-compose*.yml
.dockerignore

# Monitoring (mount as config)
monitoring/

# Scripts (copied separately)
scripts/*.log
