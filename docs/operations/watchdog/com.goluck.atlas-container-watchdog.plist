<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.goluck.atlas-container-watchdog</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kk/bin/atlas-container-watchdog.sh</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/kk/Library/Logs/atlas-watchdog.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kk/Library/Logs/atlas-watchdog.err.log</string>
    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>

