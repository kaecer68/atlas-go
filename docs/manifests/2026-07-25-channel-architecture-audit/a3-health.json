{
  "architecture_summary": "Health monitoring is split into four non-equivalent views: (1) cmd/atlas/api_routes.go liveness/readiness/Prometheus; (2) apigateway.ChannelHealthStore per-fetch real state; (3) monitoring/service.SystemService file freshness + health-store override; (4) Wave9 ChannelHealthSynthesizer events from non-ok/inactive store records with LastError.",
  "endpoints": [
    {
      "path": "/metrics",
      "method": "GET",
      "purpose": "Prometheus metrics",
      "registrar": "cmd/atlas/api_routes.go",
      "implementation_lines": "26-210",
      "probes": [],
      "is_duplicate_of": null,
      "notes": "registered by registerSimpleRoutes"
    },
    {
      "path": "/health",
      "method": "GET",
      "purpose": "Process liveness; returns status=ok and probes atlas_http/fubon_proxy ports",
      "registrar": "cmd/atlas/api_routes.go:118-121",
      "implementation_lines": "26-210",
      "probes": ["atlas_http port occupancy", "fubon_proxy port occupancy"],
      "is_duplicate_of": "/api/health (hardcoded duplicate)",
      "notes": "self listen port is now skipped to avoid recursive /health call (fixed in this session)"
    },
    {
      "path": "/ready",
      "method": "GET",
      "purpose": "Readiness: Postgres connect, replay file exists, Gateway channel count",
      "registrar": "cmd/atlas/api_routes.go:120",
      "implementation_lines": "cmd/atlas/api_routes.go; cmd/atlas/main.go",
      "probes": ["Postgres 2s connect", "replay path exists", "Gateway channel count > 0"],
      "is_duplicate_of": null,
      "notes": "returns 503 on failure"
    },
    {
      "path": "/api/health",
      "method": "GET",
      "purpose": "Hardcoded {status:ok}; no probes",
      "registrar": "cmd/atlas/main.go:1902",
      "implementation_lines": "cmd/atlas/main.go ~1902",
      "probes": [],
      "is_duplicate_of": "/health",
      "notes": "always 200; not a true alias of /health"
    },
    {
      "path": "/api/dashboard/channel-health",
      "method": "GET",
      "purpose": "Read data/state/channel_health.json; returns channel_id/status/updated_at",
      "registrar": "internal/monitoring/dashboard_api.go:1144",
      "implementation_lines": "1130-1142, 1144+",
      "probes": [],
      "is_duplicate_of": "/api/health/aggregate (partial overlap)",
      "notes": "drops last_error/latency/rate-limit; returns 200 empty array if file missing"
    },
    {
      "path": "/api/dashboard/system-health",
      "method": "GET",
      "purpose": "System-wide health from SystemService.LoadSystemHealth",
      "registrar": "internal/monitoring/api/system/handlers.go:56",
      "implementation_lines": "72; internal/monitoring/service/system.go:94-199",
      "probes": ["hand-coded list of 19 channels/engines/files + health-store override"],
      "is_duplicate_of": "/api/dashboard/channel-health",
      "notes": "channel list may diverge from canonical 37-channel registry"
    },
    {
      "path": "/api/health/aggregate",
      "method": "GET",
      "purpose": "Four-tier aggregate: portprobe, channel_health file mtime, LLM key presence, auth posture",
      "registrar": "internal/monitoring/api/system/health_aggregate.go:50",
      "implementation_lines": "168-182",
      "probes": ["liveness portprobe", "channel_health.json existence/mtime (>6h unhealthy)", "DeepSeek API key env", "auth env"],
      "is_duplicate_of": "/api/dashboard/system-health (partial overlap)",
      "notes": "always HTTP 200; overall only tied to liveness; LLM check is config proxy, not live"
    },
    {
      "path": "/api/health/data-integrity",
      "method": "GET",
      "purpose": "Deprecated data-integrity endpoint",
      "registrar": "internal/monitoring/dashboard_api.go:1191",
      "implementation_lines": "1191",
      "probes": [],
      "is_duplicate_of": null,
      "notes": "deprecated"
    },
    {
      "path": "/api/llm/health",
      "method": "GET",
      "purpose": "LLM router per-provider health",
      "registrar": "internal/monitoring/api/llm/handlers.go:28",
      "implementation_lines": "47-62",
      "probes": ["DeepSeek/MiniMax provider health", "circuit breaker state"],
      "is_duplicate_of": null,
      "notes": "RouterVersion hardcoded v2.1"
    },
    {
      "path": "/api/dashboard/macro-data-health",
      "method": "GET",
      "purpose": "Macro data health",
      "registrar": "internal/monitoring/api/macro/handlers.go:28",
      "implementation_lines": "193-199",
      "probes": ["MacroService.GetMacroDataHealth"],
      "is_duplicate_of": null,
      "notes": null
    },
    {
      "path": "/api/agents/health",
      "method": "GET",
      "purpose": "Agent status",
      "registrar": "internal/monitoring/api/control/handlers.go:28",
      "implementation_lines": "161-173",
      "probes": ["agents", "muted_count"],
      "is_duplicate_of": null,
      "notes": "not ingestion channel health"
    }
  ],
  "per_channel_health": {
    "source": "internal/apigateway/channel_health.go",
    "record_fields": ["status", "last_fetch", "data", "error", "success", "rate_limit", "latency", "records", "symbols", "errors"],
    "storage": ["JSON file", "optional DB", "fetch log"],
    "alerts": "1h stale filtering"
  },
  "wave9_synthesizer": {
    "source": "internal/monitoring/wave9_runtime.go",
    "behavior": "Scans ChannelIDs; only emits events for status != ok/inactive AND LastError != empty",
    "gap": "warn/error states with empty LastError do not become events"
  },
  "system_service_hand_coded_channels": [
    "us_yahoo", "us_spx", "us_ndx", "us_dji", "sox", "us_nvda", "us_aapl", "us_msft", "tsm_adr",
    "twse_capital_flow", "geopolitical", "twse_replay", "frankfurter_fx", "twse_margin",
    "export_statistics", "tsmc_revenue", "geopolitical_taiwan", "fugle", "fubon", "janus_regime"
  ],
  "unmonitored_channels_inference": [
    "tdcc_equity_dispersion", "twse_sbl"
  ],
  "prometheus": {
    "scrape_targets": ["atlas:18080/metrics", "prometheus", "redis", "postgres", "otel"],
    "per_channel_alert": {
      "file": "monitoring/rules/wave9_channel_individual_health.yml",
      "metric": "atlas_channel_health_errors_total{channel}",
      "threshold": "rate > 0.1 over 5m, for 5m"
    },
    "dashboard_gap": "Grafana System Health only shows up{job=\"atlas-go\"}; no per-channel health/error/latency panels"
  },
  "notes": "/health and /api/health are duplicate/conflicting endpoints with different semantics. /api/health/aggregate and /api/dashboard/system-health partially overlap but use different channel lists and checks."
}
