{
  "openapi": "3.0.3",
  "info": {
    "title": "Atlas-Go Dashboard & Reporting API",
    "description": "HTTP API for backtest reporting, macro radar, agent observatory, and experiment tracking.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/api/dashboard/macro-radar": {
      "get": {
        "summary": "Get latest macro radar data",
        "description": "Returns regime, guard outcomes, and broker runtime audit for the latest or requested session.",
        "parameters": [
          {
            "name": "session_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Optional session ID to fetch a specific session summary."
          }
        ],
        "responses": {
          "200": {
            "description": "Macro radar response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MacroRadarResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/dashboard/agent-names": {
      "get": {
        "summary": "Agent display-name registry",
        "description": "Returns the agent display-name registry from configs/agents.json. Single source of truth for the performance-report frontend, replacing two competing static maps (web/static/js/names.js and web/static/js/shared/constants.js). Returns an empty agents array when the registry file is absent (graceful degradation).",
        "responses": {
          "200": {
            "description": "Agent registry response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "agents": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {"type": "string", "description": "Agent identifier (e.g. 'foreign-flow-01')"},
                          "name": {"type": "string", "description": "Human-readable display name (e.g. '外資流向追蹤')"},
                          "skill": {"type": "string", "description": "Agent skill category"},
                          "layer": {"type": "string", "description": "Agent layer (sector / stock / etc.)"}
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error (registry parse failure)"
          }
        }
      }
    },
    "/api/dashboard/agent-observatory": {
      "get": {
        "summary": "Agent performance scorecards",
        "description": "Returns weakest agent scorecards and next experiment candidate for the latest session.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 5
            },
            "required": false,
            "description": "Maximum number of scorecards to return."
          }
        ],
        "responses": {
          "200": {
            "description": "Agent observatory response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AgentObservatoryResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid limit parameter"
          }
        }
      }
    },
    "/api/dashboard/forecast-vs-reality": {
      "get": {
        "summary": "Experiment results overview",
        "description": "Returns a list of prompt experiment results with baseline vs candidate values.",
        "parameters": [
          {
            "name": "agent_id",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": false,
            "description": "Filter results by target agent ID."
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20
            },
            "required": false,
            "description": "Maximum number of experiment items to return."
          }
        ],
        "responses": {
          "200": {
            "description": "Forecast vs reality response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ForecastVsRealityResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/report/latest": {
      "get": {
        "summary": "Get the latest backtest report",
        "description": "Returns the most recent Markdown backtest report generated by cmd/backtest-window.",
        "responses": {
          "200": {
            "description": "Markdown report content",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "No backtest report found"
          }
        }
      }
    },
    "/api/narrative/events": {
      "get": {
        "summary": "Detect macro narrative events",
        "description": "Accepts raw market/narrative inputs and returns detected NarrativeEvents (e.g., US_rates_up, AI_capex_surge).",
        "parameters": [
          {
            "name": "us10y_change_bps",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 15
            }
          },
          {
            "name": "dxy_change_pct",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 2.0
            }
          },
          {
            "name": "vix_level",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 30
            }
          },
          {
            "name": "usd_twd_change_pct",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 0
            }
          },
          {
            "name": "oil_change_pct",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 6.0
            }
          },
          {
            "name": "gold_change_pct",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 2.5
            }
          },
          {
            "name": "jpy_change_pct",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 3.0
            }
          },
          {
            "name": "ai_capex_sentiment",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 0.8
            }
          },
          {
            "name": "geopolitical_gpr",
            "in": "query",
            "schema": {
              "type": "number",
              "default": 160
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of detected narrative events",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/NarrativeEvent"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/narrative/chains": {
      "get": {
        "summary": "Get instantiated causal chains",
        "description": "Returns causal chains matched against current narrative events.",
        "responses": {
          "200": {
            "description": "List of causal chains",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "chains": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CausalChain"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/narrative/models": {
      "get": {
        "summary": "Get active investment models",
        "description": "Returns narrative-driven investment models whose active themes intersect with current events.",
        "responses": {
          "200": {
            "description": "List of active investment models",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "models": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/InvestmentModel"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/narrative/templates": {
      "get": {
        "summary": "List all causal templates",
        "description": "Returns the built-in causal narrative templates (e.g., US_rates_up, AI_capex_surge).",
        "responses": {
          "200": {
            "description": "List of templates",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "templates": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/CausalTemplate"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/control/pause-agent": {
      "post": {
        "summary": "Pause an agent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ControlAgentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/control/resume-agent": {
      "post": {
        "summary": "Resume a paused agent",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ControlAgentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/control/set-model-weight": {
      "post": {
        "summary": "Override model weight",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ControlModelWeightRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/control/sector-ban": {
      "post": {
        "summary": "Ban or unban a sector",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ControlSectorBanRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/control/audit-log": {
      "get": {
        "summary": "List human interventions",
        "responses": {
          "200": {
            "description": "Audit log",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "interventions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/HumanIntervention"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/control/active-overrides": {
      "get": {
        "summary": "Get active human overrides",
        "responses": {
          "200": {
            "description": "Active overrides",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "paused_agents": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "banned_sectors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "model_weights": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/macro/ingest": {
      "post": {
        "summary": "Trigger macro data ingestion",
        "responses": {
          "200": {
            "description": "Ingest result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/NarrativeEvent"
                      }
                    },
                    "snapshot": {
                      "$ref": "#/components/schemas/MacroDataSnapshot"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/macro/snapshot/latest": {
      "get": {
        "summary": "Get latest macro snapshot",
        "responses": {
          "200": {
            "description": "Macro snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MacroDataSnapshot"
                }
              }
            }
          },
          "404": {
            "description": "No snapshot available"
          }
        }
      }
    },
    "/api/macro/snapshot/history": {
      "get": {
        "summary": "Get historical macro snapshot",
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "required": true,
            "description": "Date in YYYY-MM-DD format"
          }
        ],
        "responses": {
          "200": {
            "description": "Macro snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MacroDataSnapshot"
                }
              }
            }
          },
          "404": {
            "description": "Snapshot not found"
          }
        }
      }
    },
    "/api/report/list": {
      "get": {
        "summary": "List available backtest reports",
        "description": "Returns a list of generated backtest Markdown reports sorted by modification time (newest first).",
        "responses": {
          "200": {
            "description": "List of reports",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/macro/capital-flow/latest": {
      "get": {
        "summary": "Get latest Taiwan institutional capital flow",
        "responses": {
          "200": {
            "description": "Capital flow data",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "foreign_investor_net": {
                      "$ref": "#/components/schemas/MacroDataPoint"
                    },
                    "domestic_fund_net": {
                      "$ref": "#/components/schemas/MacroDataPoint"
                    },
                    "dealer_net": {
                      "$ref": "#/components/schemas/MacroDataPoint"
                    },
                    "recorded_at": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No snapshot available"
          }
        }
      }
    },
    "/api/taiwan/stress-index": {
      "get": {
        "summary": "Get Taiwan Market Stress Index",
        "responses": {
          "200": {
            "description": "Taiwan stress index",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaiwanStressIndex"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics/storage": {
      "get": {
        "summary": "Get storage cleanup metrics",
        "description": "Returns the latest storage lifecycle cleanup report including deleted files, kept files, and per-policy statistics.",
        "responses": {
          "200": {
            "description": "Storage cleanup report",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StorageCleanupReport"
                }
              }
            }
          },
          "404": {
            "description": "Storage metrics endpoint not configured"
          }
        }
      }
    },
    "/api/scheduler/status": {
      "get": {
        "summary": "Get scheduled task status",
        "description": "Returns runtime status for all registered background tasks including last run, consecutive failures, and enabled state.",
        "responses": {
          "200": {
            "description": "List of task statuses",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TaskStatus"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/scheduler/toggle": {
      "post": {
        "summary": "Toggle scheduled task enabled state",
        "description": "Enable or disable a named background task.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToggleRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Task toggled successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "enabled": { "type": "boolean" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request body or missing name"
          },
          "404": {
            "description": "Task not found"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MacroRadarResponse": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "regime": {
            "type": "string",
            "example": "RISK_ON"
          },
          "guard_outcomes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GuardOutcome"
            }
          },
          "broker_runtime": {
            "$ref": "#/components/schemas/BrokerRuntimeAudit"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AgentObservatoryResponse": {
        "type": "object",
        "properties": {
          "session_id": {
            "type": "string"
          },
          "next_experiment_agent_id": {
            "type": "string"
          },
          "scorecards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Scorecard"
            }
          },
          "broker_runtime": {
            "$ref": "#/components/schemas/BrokerRuntimeAudit"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ForecastVsRealityResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ForecastVsRealityItem"
            }
          },
          "broker_runtime": {
            "$ref": "#/components/schemas/BrokerRuntimeAudit"
          }
        }
      },
      "ForecastVsRealityItem": {
        "type": "object",
        "properties": {
          "experiment_id": {
            "type": "string"
          },
          "proposal_id": {
            "type": "string"
          },
          "commit_id": {
            "type": "string"
          },
          "approval_id": {
            "type": "string"
          },
          "target_agent_id": {
            "type": "string"
          },
          "skill": {
            "type": "string"
          },
          "mutation_type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "baseline_value": {
            "type": "number"
          },
          "candidate_value": {
            "type": "number"
          },
          "recorded_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReportListResponse": {
        "type": "object",
        "properties": {
          "reports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "filename": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                },
                "updated_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "Scorecard": {
        "type": "object",
        "properties": {
          "agent_id": {
            "type": "string"
          },
          "skill": {
            "type": "string"
          },
          "layer": {
            "type": "string"
          },
          "window_count": {
            "type": "integer"
          },
          "observations": {
            "type": "integer"
          },
          "hit_rate": {
            "type": "number"
          },
          "average_return": {
            "type": "number"
          },
          "sharpe_like": {
            "type": "number"
          },
          "max_drawdown": {
            "type": "number"
          },
          "last_updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "GuardOutcome": {
        "type": "object",
        "properties": {
          "guard_id": {
            "type": "string"
          },
          "guard_skill": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "passed": {
            "type": "boolean"
          },
          "reason": {
            "type": "string"
          },
          "input_count": {
            "type": "integer"
          },
          "output_count": {
            "type": "integer"
          }
        }
      },
      "NarrativeEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "theme": {
            "type": "string",
            "example": "US_rates_up"
          },
          "region": {
            "type": "string",
            "example": "US"
          },
          "sentiment": {
            "type": "number",
            "minimum": -1.0,
            "maximum": 1.0
          },
          "confidence": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "capital_flow": {
            "type": "string",
            "example": "flight_to_USD"
          },
          "time_window": {
            "type": "string",
            "example": "1_week"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "source_data": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            }
          }
        }
      },
      "CausalStep": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "affected": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "impact": {
            "type": "number",
            "minimum": -1.0,
            "maximum": 1.0
          }
        }
      },
      "CausalTemplate": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "trigger_theme": {
            "type": "string"
          },
          "required_region": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CausalStep"
            }
          },
          "historical_hit_rate": {
            "type": "number"
          },
          "source_references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "CausalChain": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string"
          },
          "template_id": {
            "type": "string"
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CausalStep"
            }
          },
          "score": {
            "type": "number"
          }
        }
      },
      "InvestmentModel": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "active_themes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "favored_sectors": {
            "type": "array",
            "items": {
