# atlas-go — Git Attributes
# Enforces Unix (LF) line endings at the git level.
# Complements .editorconfig (editor level).

# Auto-detect text files, normalize to LF
* text=auto eol=lf

# Explicit binary files — don't modify
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary

# Go — always LF
*.go text eol=lf

# Shell scripts — always LF (shebang won't work with CRLF)
*.sh text eol=lf

# Web — always LF
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Config/data — always LF
*.json text eol=lf
*.jsonl text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.csv text eol=lf

# Markdown/docs — always LF
*.md text eol=lf
*.txt text eol=lf
