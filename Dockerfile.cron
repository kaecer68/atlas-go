# Cron job runner for Atlas
FROM golang:1.26.4-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETARCH

RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -o daily-replay-sync ./cmd/daily-replay-sync
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -o backfill-replay ./cmd/backfill-replay
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -o macro-ingest ./cmd/macro-ingest
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -o geo-ingest ./cmd/geo-ingest
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -o backfill-month-revenue ./cmd/backfill-month-revenue
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -o backfill-financial-statements ./cmd/backfill-financial-statements
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -o backfill-institutional-investors ./cmd/backfill-institutional-investors

FROM alpine:latest

# Install runtime deps (bash for cron-entrypoint.sh shell scheduler, curl for health checks)
RUN apk add --no-cache curl bash

# Create app directory
WORKDIR /app

# Copy scripts
COPY scripts/ /app/scripts/

# Make scripts executable
RUN chmod +x /app/scripts/*.sh

# Copy Go binaries from builder
COPY --from=builder /build/daily-replay-sync /app/
COPY --from=builder /build/backfill-replay /app/
COPY --from=builder /build/macro-ingest /app/
COPY --from=builder /build/geo-ingest /app/
COPY --from=builder /build/backfill-month-revenue /app/
COPY --from=builder /build/backfill-financial-statements /app/
COPY --from=builder /build/backfill-institutional-investors /app/

# Copy SQL migrations (used by CLI tools when DB pool is initialized)
COPY --from=builder /build/sql /app/sql

# Copy cron entrypoint
COPY --from=builder /build/scripts/cron-entrypoint.sh /app/cron-entrypoint.sh
RUN chmod +x /app/cron-entrypoint.sh

# Create log directory
RUN mkdir -p /var/log/cron

# Start cron in foreground via entrypoint
CMD ["/app/cron-entrypoint.sh"]
