# Cron job runner for Atlas
FROM golang:1.26.4-alpine AS builder
WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETARCH
ARG VERSION
ARG BUILDTIME
ARG GIT_COMMIT

# LDFLAGS injects internal/buildinfo so cron binaries expose the same
# runtime metadata as the main atlas binary (validation drill F4, 2026-07-20).
ENV LDFLAGS="-w -s -X github.com/kaecer68/atlas-go/internal/buildinfo.Version=${VERSION:-dev} \
    -X github.com/kaecer68/atlas-go/internal/buildinfo.Commit=${GIT_COMMIT:-unknown} \
    -X github.com/kaecer68/atlas-go/internal/buildinfo.BuildTime=${BUILDTIME:-$(date -u +%Y-%m-%dT%H:%M:%SZ)}"

RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags="$LDFLAGS" -o daily-replay-sync ./cmd/daily-replay-sync
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags="$LDFLAGS" -o backfill-replay ./cmd/backfill-replay
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags="$LDFLAGS" -o macro-ingest ./cmd/macro-ingest
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags="$LDFLAGS" -o geo-ingest ./cmd/geo-ingest
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags="$LDFLAGS" -o backfill-month-revenue ./cmd/backfill-month-revenue
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags="$LDFLAGS" -o backfill-financial-statements ./cmd/backfill-financial-statements
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags="$LDFLAGS" -o backfill-institutional-investors ./cmd/backfill-institutional-investors
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags="$LDFLAGS" -o cron-quote-backfill ./cmd/cron-quote-backfill

# C07 sector prediction observation window (PR #1201)
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags="$LDFLAGS" -o c07-obs-collector ./cmd/experimental/c07-obs-collector
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -ldflags="$LDFLAGS" -o c07-day-evaluator ./cmd/experimental/c07-day-evaluator

FROM alpine:latest

# Install runtime deps (bash for cron-entrypoint.sh shell scheduler, curl for health checks)
RUN apk add --no-cache curl bash

# Create app directory
WORKDIR /app

# Copy scripts
COPY scripts/ /app/scripts/

# Make scripts executable
RUN chmod +x /app/scripts/*.sh

# Copy Go binaries from builder
COPY --from=builder /build/daily-replay-sync /app/
COPY --from=builder /build/backfill-replay /app/
COPY --from=builder /build/macro-ingest /app/
COPY --from=builder /build/geo-ingest /app/
COPY --from=builder /build/backfill-month-revenue /app/
COPY --from=builder /build/backfill-financial-statements /app/
COPY --from=builder /build/backfill-institutional-investors /app/
COPY --from=builder /build/cron-quote-backfill /app/

# C07 sector prediction observation window binaries (PR #1201)
COPY --from=builder /build/c07-obs-collector /app/
COPY --from=builder /build/c07-day-evaluator /app/

# Copy SQL migrations (used by CLI tools when DB pool is initialized)
COPY --from=builder /build/sql /app/sql

# Copy cron entrypoint
COPY --from=builder /build/scripts/cron-entrypoint.sh /app/cron-entrypoint.sh
RUN chmod +x /app/cron-entrypoint.sh

# Create log directory
RUN mkdir -p /var/log/cron

# Start cron in foreground via entrypoint
CMD ["/app/cron-entrypoint.sh"]
