# GitNexus: local index cache. Not tracked — regenerated by `npx gitnexus analyze`.
# See docs/TOOLS.md for indexer setup; CI no longer reads committed metadata.
.gitnexus/
# codebase-memory: local knowledge graph index. Not tracked — regenerated by `codebase-memory_index_repository({mode:"full"})`.
# See docs/TOOLS.md for indexer setup; SQLite-backed at .codebase-memory/ (graph.db + graph.db.zst artifact).
.codebase-memory/
/.worktrees/

