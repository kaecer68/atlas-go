{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "us-indices.schema.json",
  "type": "object",
  "required": ["recorded_at", "generated_at", "indices", "tech_stocks", "data_status"],
  "properties": {
    "indices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "value", "change_pct"],
        "properties": {
          "symbol": { "type": "string" },
          "value": { "type": "number" },
          "change_pct": { "type": "number" }
        }
      }
    },
    "tech_stocks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["symbol", "value", "change_pct"],
        "properties": {
          "symbol": { "type": "string" },
          "value": { "type": "number" },
          "change_pct": { "type": "number" }
        }
      }
    },
    "data_status": { "type": "string" },
    "recorded_at": { "type": "number" },
    "generated_at": { "type": "string" },
    "failed_channels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "stale_channels": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
