#!/usr/bin/env bash
# scripts/hooks/pre-commit — Auto-go-generate + binary detection
#
# Install: cp scripts/hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# 1. If domain/*.go changed → runs "go generate ." and auto-stages generated files
# 2. Detects Mach-O/ELF/PE binaries in staging area → blocks commit

set -euo pipefail

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

# ---- Phase 1: Auto go generate ----
if echo "$STAGED" | grep -q '^internal/domain/.*\.go$'; then
    echo "🔧 domain structs changed → running go generate ."
    go generate . > /dev/null 2>&1
    echo ""

    # Always stage generated files (no-op if unchanged)
    git add web/static/js/shared/field_names.js web/static/js/shared/field_types.ts web/static/js/shared/field_types.d.ts 2>/dev/null || true
    echo "  ✅ generated files auto-synced"
    echo ""
fi

# ---- Phase 2: Binary detection ----
BINARIES_FOUND=false

while IFS= read -r file; do
    if [[ ! -f "$file" ]]; then
        continue
    fi

    if file "$file" | grep -qE "Mach-O|ELF|PE32|PE32\+"; then
        echo "❌ BINARY DETECTED: $file"
        echo "   Type: $(file "$file" | cut -d: -f2-)"
        BINARIES_FOUND=true
    fi
done < <(echo "$STAGED")

if $BINARIES_FOUND; then
    echo ""
    echo "⚠️  Commit blocked. Remove the binary before committing:"
    echo "   git rm --cached <file>"
    echo "   echo <file> >> .gitignore"
    exit 1
fi

exit 0
