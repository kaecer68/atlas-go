# /etc/cron.d/atlas-soak
# Daily 06:00 UTC run of the 7-day staging soak test check script.
#
# Prerequisites:
#   1. Copy this file to /etc/cron.d/atlas-soak
#   2. chmod 644 /etc/cron.d/atlas-soak
#   3. Ensure /usr/local/bin/staging-soak-check.sh is installed (cp from
#      scripts/staging-soak-check.sh in this repo, chmod 755)
#   4. Ensure the release captain user has read access to the staging
#      SQLite DB at $DATA_DB
#   5. (Optional) Configure Slack/PagerDuty alert on non-zero exit
#
# Environment overrides (optional):
#   STAGING_URL=http://staging.example.com:18080
#   DATA_DB=/var/lib/atlas/data/state/atlas.db
#   LOG_DIR=/var/log/atlas-soak
#
# Cron daemon reads this file automatically; no need to run crontab.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
STAGING_URL=http://localhost:18080
DATA_DB=/var/lib/atlas/data/state/atlas.db
LOG_DIR=/var/log/atlas-soak

# 06:00 UTC daily — after stage3 sync-events-daily at 06:00, before 13:30 sync-capital-daily
0 6 * * *  release-captain  /usr/local/bin/staging-soak-check.sh >> /var/log/atlas-soak/cron.log 2>&1
