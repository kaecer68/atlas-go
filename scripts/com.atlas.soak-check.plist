<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.atlas.soak-check</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/kaecer/bin/staging-soak-check.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>STAGING_URL</key>
        <string>http://localhost:18080</string>
        <key>LOG_DIR</key>
        <string>/Users/kaecer/logs/atlas-soak</string>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/kaecer/logs/atlas-soak/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/kaecer/logs/atlas-soak/launchd.err.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
        <key>Crashed</key>
        <true/>
    </dict>
</dict>
</plist>
