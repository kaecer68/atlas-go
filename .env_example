# =============================================================================
# Atlas Environment Configuration (Example)
#
# Copy this file to create your own configuration. The runtime reads from:
#   1. ~/.config/atlas-go/.env (preferred — outside repo scope)
#   2. ./.env (repo-local, for IDE/editor convenience only)
#
# Secrets (API keys, passwords) are stored in macOS Keychain.
# Use: security find-generic-password -a "KEY_NAME" -s com.kaecer68.atlas-go -w
# To override a Keychain value, set the env var here (uncommented).
# =============================================================================

# --- Market Data ---
ATLAS_MARKET_DATA_PROVIDER=hybrid

# --- FinMind (stored in Keychain: FINMIND_API_KEY) ---
# FINMIND_API_KEY=your_finmind_api_key

# --- Fugle (stored in Keychain: FUGLE_API_KEY) ---
# FUGLE_API_KEY=your_fugle_api_key

# --- TEJ (stored in Keychain: TEJ_API_KEY) ---
# TEJ_API_KEY=your_tej_api_key

# --- PostgreSQL (needed by docker-compose for local dev) ---
# DATABASE_URL enables the DualWrite backend — JSONL for immutability + PostgreSQL
# for efficient queries, concurrent access, and schema-migration management.
DB_PASSWORD=atlas
DATABASE_URL=postgres://atlas:atlas@localhost:5432/atlas?sslmode=disable

# --- Fubon Broker (needed by services/fubon-proxy/main.py) ---
# FUBON_API_KEY=your_fubon_api_key
# FUBON_PERSONAL_ID=your_id_number

# --- Fubon Password (stored in Keychain: FUBON_PASSWORD) ---
# FUBON_PASSWORD=your_fubon_password

# --- Fubon Certificate ---
# FUBON_CERT_PATH=/path/to/your/certificate.p12
# FUBON_CERT_PASSWORD=your_cert_password

# --- Fubon Proxy ---
FUBON_PROXY_URL=http://localhost:8081

# --- Grafana (for docker-compose) ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Replay Data ---
ATLAS_REPLAY_DATA_PATH=data/replay/tw_extended_90days.csv
ATLAS_YAHOO_ENABLED=true
