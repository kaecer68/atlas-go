{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PROJECT_DIR:-}\" ] && [ -x \"$CLAUDE_PROJECT_DIR/scripts/session-start.sh\" ]; then \"$CLAUDE_PROJECT_DIR/scripts/session-start.sh\"; fi",
            "timeout": 600,
            "statusMessage": "Checking Atlas binary freshness..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -n \"${CLAUDE_PROJECT_DIR:-}\" ] && [ -f \"$CLAUDE_PROJECT_DIR/.agent-hooks/pretooluse-deny-dangerous.sh\" ]; then bash \"$CLAUDE_PROJECT_DIR/.agent-hooks/pretooluse-deny-dangerous.sh\"; fi",
            "timeout": 10,
            "statusMessage": "agent-guard: checking command against deny-dangerous rules..."
          }
        ]
      }
    ]
  }
}
